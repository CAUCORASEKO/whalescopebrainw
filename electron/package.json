{
  "name": "whalescope",
  "version": "1.0.0",
  "description": "WhaleScope Desktop — On-chain & Market Intelligence",
  "author": "Claudio Valenzuela",
  "license": "MIT",

  "main": "main.js",

  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:arm": "electron-builder --mac --arm64",
    "dist:intel": "electron-builder --mac --x64"
  },

  "dependencies": {
    "chart.js": "^4.5.0",
    "dotenv": "^17.2.1",
    "flatpickr": "^4.6.13",
    "level": "^10.0.0",
    "plotly.js": "^3.1.0"
  },

  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },

  "build": {
    "appId": "com.whalescope.app",
    "productName": "WhaleScope",

    "directories": {
      "output": "dist",
      "buildResources": "build"
    },

    "files": [
      "**/*",
      "!**/.venv/**",
      "!**/__pycache__/**"
    ],

    "extraResources": [
      {
        "from": "../.venv",
        "to": "python",
        "filter": ["**/*"]
      },
      {
        "from": "../python/whalescope_scripts",
        "to": "python/whalescope_scripts",
        "filter": ["**/*"]
      }
    ],

    "afterPack": "afterPackFix.js",

    "mac": {
      "category": "public.app-category.finance",
      "target": ["dmg"]
    }
  }
}